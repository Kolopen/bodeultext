#!/usr/bin/env bash
# 인식 결과와 정답을 채점하기 전에 조각을 어절로 되붙인다 ("얼굴 +이" -> "얼굴이").
# 그래야 WER이 사람이 읽는 띄어쓰기 단위로 나온다.
#
# 첫 칸은 발화 ID 라서 건드리지 않는다. 인식 결과가 "+이" 처럼 이어 붙는 조각으로
# 시작하면 앞에 붙일 어절이 없으므로 "+" 만 떼고 새 어절로 둔다. (예전에는
# sed 's/ +//g' 로 지워서 그 조각이 발화 ID 에 붙었고, ID 가 바뀐 발화는 채점에서
# 빠졌다 -> [PARTIAL])
awk '{
  out = $1; w = ""
  for (i = 2; i <= NF; i++) {
    t = $i
    if (substr(t, 1, 1) == "+" && w != "") { w = w substr(t, 2) }
    else {
      if (w != "") out = out " " w
      w = (substr(t, 1, 1) == "+") ? substr(t, 2) : t
    }
  }
  if (w != "") out = out " " w
  print out
}'
